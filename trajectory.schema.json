{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wjesseclements/apex-ascent/trajectory.schema.json",
  "title": "apex-ascent trajectory",
  "description": "GENERATED from app/src/engine/schema.ts by `npm run schema:generate` — do not edit.",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "checkpointStep": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "trackId": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "physicsConfigHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "dt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "sampleCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "crashed": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "checkpointStep",
        "policy",
        "trackId",
        "physicsConfigHash",
        "seed",
        "dt",
        "createdAt",
        "sampleCount",
        "crashed"
      ]
    },
    "laps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lapTimeSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "startStep": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "lapTimeSec",
          "startStep"
        ]
      }
    },
    "samples": {
      "type": "object",
      "properties": {
        "t": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "x": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "y": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "heading": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": -3.141592653589793,
            "maximum": 3.141592653589793
          }
        },
        "speed": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "steer": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "drive": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "aLong": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "aLat": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "t",
        "x",
        "y",
        "heading",
        "speed",
        "steer",
        "drive",
        "aLong",
        "aLat"
      ]
    }
  },
  "required": [
    "meta",
    "laps",
    "samples"
  ]
}
